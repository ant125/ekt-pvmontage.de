# Copy to .env.local and fill in values. Never commit real secrets.

# Supabase Postgres (Prisma)
DATABASE_URL=

# Signed admin session (HMAC). Use a long random string (16+ chars).
JWT_SECRET=

# Supabase Storage (server-only service role — never expose as NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form
RESEND_API_KEY=
CONTACT_EMAIL=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: used by `prisma db seed` only
# ADMIN_PASSWORD=
